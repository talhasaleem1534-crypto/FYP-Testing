# Copy to .env next to docker-compose.yml
ANTHROPIC_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set the same value in the GitHub repo's webhook settings
GITHUB_WEBHOOK_SECRET=
# Only for real, publicly resolvable domains
TRAEFIK_ENABLE_TLS=false

# Any long random string. The backend requires it from the ai-engine container (it is not on loopback).
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
