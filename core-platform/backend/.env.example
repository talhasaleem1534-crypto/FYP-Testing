# Copy to .env (never commit .env)
PORT=3000
# 0.0.0.0 = customers on other devices of the same network can use the customer portal.
# 127.0.0.1 = only this laptop (every route needs a login either way).
HOST=0.0.0.0

# Browser origins allowed to call the API (comma separated). This laptop's LAN addresses on ports 5173/4173 are always added.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Apps, servers and deployment history are saved here (default: ~/.paas-data). PAAS_PERSISTENCE=off disables it.
# PAAS_DATA_DIR=

# Where deployed apps are cloned (default: ~/paas-apps)
# PAAS_APPS_DIR=

# GitHub push webhook: set the same secret in the repo's webhook settings.
# If unset, webhook requests are NOT authenticated.
# GITHUB_WEBHOOK_SECRET=

# Traefik: only enable TLS for real, publicly resolvable domains
# TRAEFIK_ENABLE_TLS=false
# TRAEFIK_CERT_RESOLVER=letsencrypt

# Requests from this laptop without a login token (curl, tests, the AI engine) are treated as the admin.
# Set to off to require a login even here.
# PAAS_TRUST_LOCALHOST=on

# Shared secret for other platform services that are NOT on this laptop's loopback (e.g. the AI engine
# container in docker-compose). They send it in the X-Internal-Token header.
# INTERNAL_API_TOKEN=
